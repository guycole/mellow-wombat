--
-- Title: wombat_tasking.psql
-- Description: 
--
--
create table wombat_tasking (
  id           bigserial    primary key,
  active_flag  boolean      not null,
  assign_time  timestamp    not null default CURRENT_TIMESTAMP,
  crate_name   varchar(16)  not null,
  host_name    varchar(16)  not null,
  host_type    varchar(16)  not null,
  ip_address   varchar(16)  not null,
  rx_antenna   varchar(48)  not null,
  rx_id        smallint     not null,
  rx_task      varchar(48)  not null,
  rx_type      varchar(64)  not null,
  storage      varchar(16)  not null
);

grant select, insert, update, delete on wombat_tasking to wombat_client;
grant usage, select on sequence wombat_tasking_id_seq to wombat_client;

