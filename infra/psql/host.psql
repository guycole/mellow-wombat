--
-- Title: wombat_host.psql
-- Description: host inventory
--
--
create table wombat_host (
  id           bigserial    primary key,
  active_flag  boolean      not null,
  crate_name   varchar(16)  not null,
  host_name    varchar(16)  not null,
  host_type    varchar(16)  not null,
  ip_address   varchar(16)  not null,
  role_type    varchar(16)  not null,
  storage      varchar(16)  not null
);

grant select, insert, update, delete on wombat_host to wombat_host;
grant usage, select on sequence wombat_host_id_seq to wombat_host;

